{
  "name": "wirelith-playground",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "lint": "biome check . && node scripts/hygiene/lint-actions.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/build-site.mjs",
    "check-site": "node scripts/check-site.mjs",
    "preview": "node scripts/build-site.mjs && node scripts/serve.mjs",
    "conformance": "node vendor/wirelith/conformance/runner/run.mjs --diagnostics \"node test/conformance/adapter.mjs diagnostics\" --svg \"node test/conformance/adapter.mjs svg\"",
    "check-licenses": "node scripts/check-licenses.mjs",
    "check-upstream": "node scripts/check-upstream.mjs",
    "hygiene": "node scripts/hygiene/check-holder.mjs --tree && node scripts/hygiene/denylist.mjs --tree"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "@xmldom/xmldom": "0.9.12",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
